{#- Autoescaped: every value from the scan is untrusted and must stay text.
    Never use |safe on scan data, and never add style= or on* attributes: the CSP
    only allows the inlined stylesheet and the inlined script. -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="referrer" content="no-referrer">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<meta name="generator" content="recon-report {{ ctx.tool_version }}">
<title>Reconnaissance report: {{ ctx.label }}</title>
<style>{{ css }}</style>
</head>
<body>
<main class="report">

<header class="report-header">
<div class="header-top">
<p class="eyebrow">Network reconnaissance report</p>
<button type="button" class="save-pdf" id="save-pdf" hidden>Save as PDF</button>
</div>
<noscript><p class="print-hint">To save this report as a PDF, press Ctrl+P (Cmd+P on Mac) and untick &ldquo;Headers and footers&rdquo; in the print dialog.</p></noscript>
<h1>{{ ctx.label }}</h1>
{% if ctx.notice %}
<p class="notice" role="note"><strong>Note:</strong> {{ ctx.notice }}</p>
{% endif %}
<dl class="meta">
<div class="wide"><dt>Targets</dt><dd>
{% if ctx.targets %}
<ul class="plain">
{% for target in ctx.targets %}
<li class="mono">{{ target }}</li>
{% endfor %}
{% if ctx.targets_more %}
<li>and {{ ctx.targets_more }} more</li>
{% endif %}
</ul>
{% else %}
No hosts reported
{% endif %}
</dd></div>
<div><dt>Scan started</dt><dd>{{ ctx.scan_started }}</dd></div>
<div><dt>Scan finished</dt><dd>{{ ctx.scan_finished }}</dd></div>
<div><dt>Duration</dt><dd>{{ ctx.duration }}</dd></div>
<div><dt>Nmap version</dt><dd>{{ ctx.nmap_version }}</dd></div>
<div class="wide"><dt>Nmap command</dt><dd><code>{{ ctx.nmap_command }}</code></dd></div>
<div><dt>recon-report version</dt><dd>{{ ctx.tool_version }}</dd></div>
<div><dt>Report generated</dt><dd>{{ ctx.generated_at }}</dd></div>
</dl>
<p class="notice notice-auth" role="note"><strong>Authorized testing only.</strong> recon-report is intended for authorized security testing. Scan only systems you own or have explicit written permission to test. This report describes the exposure of the scanned systems: handle it as confidential.</p>
</header>

<section id="summary" aria-labelledby="summary-title">
<h2 id="summary-title">1. Executive summary</h2>
<ul class="counts">
{% for item in ctx.counts %}
<li class="count-card sev-{{ item.severity.name|lower }}{{ " is-zero" if not item.count else "" }}"><span class="count">{{ item.count }}</span> <span class="count-label">{{ item.severity.label }}</span></li>
{% endfor %}
</ul>
<p class="summary">{{ ctx.summary }}</p>
</section>

<section id="hosts" aria-labelledby="hosts-title">
<h2 id="hosts-title">2. Hosts and open ports</h2>
{% if not ctx.hosts_up and not ctx.hosts_not_up %}
<p class="empty">The scan did not report any hosts.</p>
{% endif %}
{% for host in ctx.hosts_up %}
<article class="host">
<h3><span class="mono">{{ host.address }}</span>{% if host.hostnames %} <span class="hostnames">{{ host.hostnames|join(", ") }}</span>{% endif %}</h3>
{% if host.ports %}
<div class="table-wrap">
<table>
<caption class="visually-hidden">Open ports on {{ host.label }}</caption>
<thead><tr><th scope="col">Port</th><th scope="col">Service</th><th scope="col">Version</th><th scope="col">Detection</th></tr></thead>
<tbody>
{% for port in host.ports %}
<tr><td class="mono nowrap">{{ port.port }}</td><td>{{ port.service }}</td><td class="mono version">{{ port.version or "—" }}</td><td>{{ port.detection }}</td></tr>
{% endfor %}
</tbody>
</table>
</div>
{% else %}
<p class="empty">No open ports found.</p>
{% endif %}
{% if host.not_shown %}
<p class="not-shown">{{ host.not_shown }}</p>
{% endif %}
</article>
{% endfor %}
{% if ctx.hosts_not_up %}
<h3>Hosts not up</h3>
<ul>
{% for host in ctx.hosts_not_up %}
<li><span class="mono">{{ host.label }}</span>: {{ host.status }}</li>
{% endfor %}
</ul>
{% endif %}
</section>

<section id="findings" aria-labelledby="findings-title">
<h2 id="findings-title">3. Findings</h2>
{% if ctx.findings %}
<p>Findings are sorted by severity, most severe first.</p>
{% for finding in ctx.findings %}
<article class="finding sev-{{ finding.severity.name|lower }}" id="finding-{{ loop.index }}">
<div class="finding-head">
<span class="badge">{{ finding.severity.label }}</span>
<h3>{{ loop.index }}. {{ finding.title }}</h3>
</div>
<dl class="finding-meta">
<div><dt>Host</dt><dd><span class="mono">{{ finding.host }}</span>{% if finding.hostname %} ({{ finding.hostname }}){% endif %}</dd></div>
<div><dt>Port</dt><dd class="mono">{{ finding.port }}/{{ finding.protocol }}</dd></div>
<div><dt>Confidence</dt><dd>{{ finding.confidence.value|capitalize }}: {{ confidence_notes[finding.confidence] }}</dd></div>
<div><dt>Rule</dt><dd class="mono">{{ finding.rule_id }}</dd></div>
</dl>
<h4>Evidence</h4>
<pre class="evidence"><code>{{ finding.evidence }}</code></pre>
<h4>Description</h4>
<p>{{ finding.description }}</p>
<h4>Recommendation</h4>
<p>{{ finding.recommendation }}</p>
{% if finding.references %}
<h4>References</h4>
<ul class="references">
{% for ref in finding.references %}
<li>{% if ref is https_url %}<a href="{{ ref }}" rel="noopener noreferrer">{{ ref }}</a>{% else %}{{ ref }}{% endif %}</li>
{% endfor %}
</ul>
{% endif %}
</article>
{% endfor %}
{% else %}
<p class="empty">No findings. No open service matched the rules described in the methodology below. This does not prove the scanned hosts are free of vulnerabilities.</p>
{% endif %}
</section>

<section id="methodology" class="methodology" aria-labelledby="methodology-title">
<h2 id="methodology-title">4. Methodology and limitations</h2>
<h3>How the scan was run</h3>
<p>Hosts and services were discovered with Nmap using the command shown in the report header. {{ ctx.scan_method }}</p>
<p>Each open port on each host that was up was then assessed against recon-report's built-in rules: {{ ctx.service_rule_count }} service exposure rules (cleartext protocols, remote administration, databases and management APIs) and {{ ctx.version_rule_count }} version rules (outdated, end-of-life or known-vulnerable releases). No exploitation, authentication attempts or vulnerability probing were performed.</p>
<h3>Confidence levels</h3>
<ul>
{% for level, note in confidence_notes.items() %}
<li><strong>{{ level.value|capitalize }}:</strong> {{ note }}.</li>
{% endfor %}
</ul>
<h3>Limitations</h3>
<ul>
<li>Version findings are based only on the version reported in the service banner. {{ ctx.backport_note }}</li>
<li>Version rule thresholds were last reviewed against official vendor lifecycle and advisory pages on {{ ctx.rules_last_reviewed }}. Releases and end-of-life dates after that are not reflected.</li>
<li>The scan shows only what was reachable from the scanning host at the time of the scan. Filtered ports, ports and protocols that were not scanned, and changes made after the scan are not covered.</li>
<li>Findings indicate exposure and likely risk, not confirmed vulnerabilities. The absence of findings does not mean a host is secure.</li>
</ul>
</section>

</main>
<footer class="report-footer">
<p>Generated by recon-report {{ ctx.tool_version }} on {{ ctx.generated_at }}.</p>
</footer>
<script>{{ js }}</script>
</body>
</html>
